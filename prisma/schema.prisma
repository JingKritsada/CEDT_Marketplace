// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  studentId        String    @unique
  email            String    @unique
  displayName      String
  password         String   
  avatarUrl        String?
  listings         Listing[] @relation("UserListings")
  boughtChatRooms  ChatRoom[] @relation("BuyerRooms")
  soldChatRooms    ChatRoom[] @relation("SellerRooms")
  messages         Message[]
  createdAt        DateTime  @default(now())
}

enum ListingStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model Listing {
  id               String        @id @default(uuid())
  title            String
  description      String
  price            Float
  isFree           Boolean       @default(false)
  status           ListingStatus @default(AVAILABLE)
  images           String[]
  courseCode       String?
  seller           User          @relation("UserListings", fields: [sellerId], references: [id])
  sellerId         String
  category         Category      @relation(fields: [categoryId], references: [id])
  categoryId       String
  pickupLocation   PickupLocation @relation(fields: [pickupLocationId], references: [id])
  pickupLocationId String
  chatRooms        ChatRoom[]
  createdAt        DateTime      @default(now())
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  listings Listing[]
}

model PickupLocation {
  id          String    @id @default(uuid())
  name        String
  building    String
  description String?
  listings    Listing[]
}

model ChatRoom {
  id        String    @id @default(uuid())
  listing   Listing   @relation(fields: [listingId], references: [id])
  listingId String
  buyer     User      @relation("BuyerRooms", fields: [buyerId], references: [id])
  buyerId   String
  seller    User      @relation("SellerRooms", fields: [sellerId], references: [id])
  sellerId  String
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id         String   @id @default(uuid())
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id])
  chatRoomId String
  sender     User     @relation(fields: [senderId], references: [id])
  senderId   String
  content    String
  createdAt  DateTime @default(now())
}