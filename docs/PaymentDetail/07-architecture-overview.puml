@startuml architecture-overview
!define CLIENT_COLOR #FFE4E1
!define BACKEND_COLOR #E1F5FF
!define EXTERNAL_COLOR #FFE082
!define DATABASE_COLOR #C8E6C9

rectangle "Frontend (iOS App)" as frontend <<CLIENT_COLOR>> {
  rectangle "Auth Flow" as auth_view
  rectangle "Seller Onboarding" as onboard_view
  rectangle "Marketplace Browse" as browse_view
  rectangle "Checkout UI" as checkout_view
  rectangle "Payment Widget" as payment_view
  rectangle "Profile & Analytics" as profile_view
}

rectangle "Backend Server (Node.js)" as backend <<BACKEND_COLOR>> {
  rectangle "API Routes" as routes {
    card "auth-route"
    card "user-route"
    card "seller-route"
    card "listing-route"
    card "cart-route"
    card "payment-route"
    card "payout-route"
    card "review-route"
  }
  
  rectangle "Controllers" as controllers {
    card "auth-controller"
    card "user-controller"
    card "cart-controller"
    card "listing-controller"
    card "payment-controller"
    card "payout-controller"
  }
  
  rectangle "Services" as services {
    card "auth-service"
    card "user-service"
    card "listing-service"
    card "payment-service"
    card "stripe-service"
    card "payout-service"
  }
  
  rectangle "Middleware" as middleware {
    card "auth (JWT verification)"
    card "error-handler"
    card "logger"
    card "rate-limit"
    card "validate"
  }
  
  rectangle "Webhooks" as webhooks {
    card "POST /webhooks/stripe"
    card "processes payment_intent events"
    card "processes payout events"
    card "processes account events"
  }
}

rectangle "Stripe" as stripe <<EXTERNAL_COLOR>> {
  rectangle "Payment Processing" as payment_proc {
    card "PaymentIntent"
    card "Payment Methods"
    card "Charges"
    card "Refunds"
  }
  
  rectangle "Stripe Connect" as connect {
    card "Connected Accounts"
    card "Onboarding Links"
    card "Account Verification"
    card "Payouts"
  }
  
  rectangle "Webhooks" as stripe_webhooks {
    card "payment_intent.succeeded"
    card "payment_intent.payment_failed"
    card "charge.refunded"
    card "account.updated"
    card "payout.paid"
    card "payout.failed"
  }
}

rectangle "Database (PostgreSQL)" as database <<DATABASE_COLOR>> {
  rectangle "User Management" as users_db {
    card "User (id, email, password_hash)"
    card "SellerProfile (stripe_account_id, status)"
  }
  
  rectangle "Commerce Tables" as commerce_db {
    card "Listing (name, price, status)"
    card "Category (name, description)"
    card "Cart & CartItem"
  }
  
  rectangle "Payment & Payout" as payment_db {
    card "Payment (stripe_intent_id, amount, status)"
    card "PayoutLedger (stripe_payout_id, status)"
    card "SellerBalance (pending, available, earned)"
  }
  
  rectangle "Reviews & Interactions" as review_db {
    card "Review (rating, comment)"
    card "PickupLocation"
    card "Notification"
  }
}

rectangle "External Services" as external <<EXTERNAL_COLOR>> {
  card "Google Maps (pickup location)"
  card "File Storage (AWS S3)"
  card "Email Service (SendGrid)"
  card "SMS Service (Twilio)"
}

frontend --|> routes : HTTP REST\nAPI Calls

routes --> controllers : Route dispatching
controllers --> services : Business Logic

services --> middleware : Validation\n& Auth
middleware --> database : Read/Write

services --|> stripe : Create PaymentIntent\nCreate Stripe Account\nCreate Payout

stripe --|> stripe_webhooks : Event Triggers

stripe_webhooks --|> webhooks : HTTPS POST\n(signature verified)

webhooks --> services : Process Events
services --> database : Update State

database --|> services : Query Data

frontend --|> stripe : Stripe.js SDK\nPayment widget

frontend --|> external : Image Upload\nLocation Services

services --|> external : Store Images\nSend Emails

note right of frontend
  iOS App handles:
  - User authentication
  - Stripe payment UI
  - Browse & search marketplace
  - Seller onboarding redirect
  - Cart management
  - Profile & analytics
  
  Never stores sensitive payment data
end note

note right of backend
  Backend handles:
  - JWT token verification
  - Business logic validation
  - Database transactions
  - Stripe API calls
  - Webhook signature verification
  - Error handling & logging
  
  Source of truth for:
  - Payment status
  - Payout records
  - User balances
end note

note right of stripe
  Stripe handles:
  - Card tokenization
  - Payment authorization
  - Identity verification
  - Bank account verification
  - PCI compliance
  - Actual fund transfers
  - Payout scheduling
  
  Your app stores only:
  - Stripe IDs
  - Status flags
end note

note right of database
  Persistent storage:
  - User accounts & credentials
  - Seller information & status
  - Listings & catalog
  - Payment history
  - Payout records
  - Balances & ledgers
  - Reviews & interactions
end note

@enduml
