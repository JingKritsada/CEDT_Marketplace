@startuml architecture-overview
!define CLIENT_COLOR #FFE4E1
!define BACKEND_COLOR #E1F5FF
!define EXTERNAL_COLOR #FFE082
!define DATABASE_COLOR #C8E6C9

rectangle "Frontend (iOS App)" as frontend <<CLIENT_COLOR>> {
  rectangle "Auth Flow" as auth_view
  rectangle "Seller Onboarding\n(opens Stripe AccountLink\nin SFSafariViewController)" as onboard_view
  rectangle "Marketplace Browse" as browse_view
  rectangle "Cart & Checkout UI" as checkout_view
  rectangle "Stripe PaymentSheet\n(card + PromptPay)" as payment_view
  rectangle "Pickup / Confirm Receipt" as pickup_view
  rectangle "Seller Wallet\n(live Stripe balance + payouts)" as wallet_view
}

rectangle "Backend Server (Node.js / Express / Prisma)" as backend <<BACKEND_COLOR>> {
  rectangle "Routes" as routes {
    card "auth-route"
    card "user-route"
    card "listing-route"
    card "cart-route"
    card "seller-onboarding-route"
    card "payment-route"
    card "review-route"
    card "webhook-route\n(express.raw — pre-json middleware)"
  }

  rectangle "Controllers" as controllers {
    card "auth-controller"
    card "user-controller"
    card "listing-controller"
    card "cart-controller"
    card "seller-onboarding-controller"
    card "payment-controller"
    card "webhook-controller"
  }

  rectangle "Services" as services {
    card "auth-service"
    card "user-service"
    card "listing-service"
    card "stripe-service\n(thin Stripe SDK wrapper)"
    card "seller-onboarding-service"
    card "payment-service\n(checkout / capture / cancel / refund)"
    card "webhook-service\n(idempotent event dispatcher)"
  }

  rectangle "Middleware" as middleware {
    card "JWT auth"
    card "stripe-raw-body"
    card "error-handler"
    card "rate-limit"
    card "zod validate"
  }

  rectangle "Background jobs" as jobs {
    card "expire-stale-auths (every 1h):\ncancel PIs > 6 days in REQUIRES_CAPTURE"
  }
}

rectangle "Stripe" as stripe <<EXTERNAL_COLOR>> {
  rectangle "Payments" as payment_proc {
    card "PaymentIntents\n(capture_method=manual)"
    card "Charges"
    card "Refunds\n(reverse_transfer + refund_application_fee)"
    card "PromptPay payment method"
  }

  rectangle "Stripe Connect (Express, country=TH)" as connect {
    card "Connected Accounts"
    card "AccountLinks (onboarding)"
    card "Destination Charges\n(application_fee_amount + transfer_data)"
    card "Payouts\n(auto, T+7 business days, THB)"
    card "Balance API (per connected acct)"
  }

  rectangle "Webhook events we handle" as stripe_webhooks {
    card "payment_intent.* (requires_action,\nprocessing, amount_capturable_updated,\nsucceeded, payment_failed, canceled)"
    card "charge.succeeded / refunded /\ndispute.created"
    card "application_fee.refunded"
    card "transfer.reversed"
    card "account.updated"
    card "payout.paid / payout.failed"
  }
}

rectangle "Database (PostgreSQL via Prisma)" as database <<DATABASE_COLOR>> {
  rectangle "Identity" as users_db {
    card "User"
    card "SellerProfile\n(stripeConnectAccountId,\nconnectStatus, chargesEnabled,\npayoutsEnabled, totals)"
    card "RefreshToken"
  }
  rectangle "Commerce" as commerce_db {
    card "Listing\n(+ currentPaymentIntentId)"
    card "Category, PickupLocation"
    card "Cart, CartItem"
  }
  rectangle "Payments" as payment_db {
    card "Payment\n(stripePaymentIntentId, charge,\napplicationFee, transfer ids,\nstatus, amounts in SATANG)"
    card "Refund"
    card "StripeWebhookEvent (idempotency)"
  }
  rectangle "Social" as review_db {
    card "Review"
  }
}

rectangle "External" as external <<EXTERNAL_COLOR>> {
  card "Object storage (S3-compatible)\nfor listing images"
  card "Push notifications (APNs)"
}

frontend --> routes : HTTPS REST + Bearer JWT
routes --> controllers
controllers --> services
services --> database : Prisma
services --> stripe : SDK calls\n(server-side only)
stripe --> stripe_webhooks
stripe_webhooks --> routes : POST /webhooks/stripe\n(raw body, verified signature)

frontend --> stripe : Stripe iOS SDK\n(PaymentSheet, AccountLink)
frontend --> external : direct upload via signed URLs

note right of frontend
  iOS app:
  - Never sees Stripe secret keys.
  - Card details NEVER hit our backend
    (PaymentSheet talks to Stripe directly).
  - For seller wallet, calls our backend,
    which proxies stripe.balance.retrieve.
end note

note right of backend
  Source of truth for:
  - Listing ownership & status
  - Order/payment history
  - Idempotent webhook processing

  NOT source of truth for:
  - Live seller balance  → Stripe
  - Payout schedule       → Stripe
  - Card data             → Stripe
end note

note right of stripe
  Stripe (Thailand) handles:
  - PCI scope (card tokenization)
  - 3DS / SCA
  - KYC / identity verification
  - Connected-account balances
  - Automatic payouts (T+7, THB)
  - PromptPay rails
end note

@enduml
