@startuml webhook-processing-flow
!define STRIPE_COLOR #FFE082
!define BACKEND_COLOR #E1F5FF
!define DB_COLOR #C8E6C9

' POST /webhooks/stripe is mounted with express.raw({type:'application/json'})
' BEFORE express.json(), so the signature can be verified against the raw body.
' Every handler is idempotent via the StripeWebhookEvent table.

participant Stripe   as "Stripe"
participant Endpoint as "POST /webhooks/stripe"
participant DB       as "Postgres"

Stripe -> Endpoint: HTTP POST (raw body + stripe-signature header)
activate Endpoint

Endpoint -> Endpoint: stripe.webhooks.constructEvent(\n  rawBody, sigHeader, STRIPE_WEBHOOK_SECRET)
alt signature invalid
  Endpoint --> Stripe: 400 (Stripe will retry; that's fine)
  deactivate Endpoint
end

Endpoint -> DB: INSERT StripeWebhookEvent { id=event.id, type, payload }
alt unique violation (already processed)
  Endpoint --> Stripe: 200 OK (duplicate, no-op)
  deactivate Endpoint
end

Endpoint -> Endpoint: dispatch(event.type)

== payment_intent.requires_action ==
Endpoint -> DB: Payment.status = REQUIRES_ACTION
Endpoint --> Stripe: 200

== payment_intent.processing  (PromptPay, async) ==
Endpoint -> DB: Payment.status = PROCESSING
Endpoint --> Stripe: 200

== payment_intent.amount_capturable_updated  (card auth ok) ==
Endpoint -> DB: Payment.status = REQUIRES_CAPTURE\n              Listing.status = PAID
Endpoint --> Stripe: 200

== payment_intent.succeeded ==
Endpoint -> DB: Payment.status = SUCCEEDED\n              capturedAt, succeededAt = now()\n              Listing.status = RECEIVED (if not already)
Endpoint --> Stripe: 200

== payment_intent.payment_failed ==
Endpoint -> DB: Payment.status = FAILED\n              failureCode, failureMessage\n              Listing.status = AVAILABLE\n              Listing.currentPaymentIntentId = NULL
Endpoint --> Stripe: 200

== payment_intent.canceled ==
Endpoint -> DB: Payment.status = CANCELED\n              Listing.status = AVAILABLE\n              Listing.currentPaymentIntentId = NULL
Endpoint --> Stripe: 200

== charge.succeeded ==
Endpoint -> DB: Payment.stripeChargeId = event.data.object.id
Endpoint --> Stripe: 200

== charge.refunded ==
Endpoint -> DB: Payment.status = REFUNDED or PARTIALLY_REFUNDED\n              INSERT/UPDATE Refund rows from charge.refunds.data
note right
  Note: this event alone does NOT touch
  SellerProfile.totalEarnedSatang. The
  follow-up transfer.reversed event does.
end note
Endpoint --> Stripe: 200

== application_fee.refunded ==
Endpoint -> DB: mark Refund.refundApplicationFee = true
Endpoint --> Stripe: 200

== transfer.reversed ==
Endpoint -> DB: SellerProfile.totalEarnedSatang -= reversed amount\n              mark Refund.reverseTransfer = true
Endpoint --> Stripe: 200

== charge.dispute.created ==
Endpoint -> DB: Payment metadata.dispute = open\n              freeze related Listing (admin review)
Endpoint -> Endpoint: send admin alert
Endpoint --> Stripe: 200

== account.updated  (Connect) ==
Endpoint -> DB: Refresh SellerProfile from event.data.object:\n  - chargesEnabled, payoutsEnabled\n  - detailsSubmitted\n  - requirementsDisabledReason\n  - requirementsCurrentlyDue (string[])\n  - connectStatus derived:\n      payoutsEnabled && chargesEnabled → ACTIVE\n      disabledReason set               → RESTRICTED\n      else                              → PENDING
Endpoint --> Stripe: 200

== payout.paid  (Connect-scoped, stripeAccount on header) ==
Endpoint -> DB: SellerProfile.totalPaidOutSatang += amount
Endpoint -> Endpoint: push notification to seller
Endpoint --> Stripe: 200

== payout.failed  (Connect-scoped) ==
Endpoint -> DB: log failure reason
Endpoint -> Endpoint: admin alert + notify seller\n              ("update your bank info")
Endpoint --> Stripe: 200

== unknown / unhandled type ==
Endpoint --> Stripe: 200 (ack, ignore)
deactivate Endpoint

note over Endpoint
  Every state mutation runs in the same DB
  transaction as the StripeWebhookEvent insert,
  so a crash mid-handler cannot leave a
  duplicate-event window.
end note

@enduml
