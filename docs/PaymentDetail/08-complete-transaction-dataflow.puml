@startuml complete-transaction-dataflow
!define FRONTEND_COLOR #FFE4E1
!define BACKEND_COLOR #E1F5FF
!define STRIPE_COLOR #FFE082
!define DB_COLOR #C8E6C9
!define BANK_COLOR #A8D5BA

' End-to-end flow with manual capture + destination charges.
' All money values are in THB satang (smallest unit).

rectangle "1. Checkout request" as step1 {
  package "Frontend"  as p1 <<FRONTEND_COLOR>> {
    (User taps Buy Now) as e1
    (POST /checkout {listingId}) as e2
  }
  package "Backend (tx)" as p2 <<BACKEND_COLOR>> {
    (SELECT listing FOR UPDATE) as v1
    (Assert AVAILABLE\n+ buyer != seller\n+ seller.payoutsEnabled) as v2
    (platformFee = amount * BPS / 10000) as v3
  }
}

rectangle "2. PaymentIntent creation" as step2 {
  package "Backend"  as p3 <<BACKEND_COLOR>> {
    (paymentIntents.create\n  capture_method=manual\n  application_fee_amount\n  transfer_data.destination\n  on_behalf_of) as s1
  }
  package "Stripe" as p4 <<STRIPE_COLOR>> {
    (PI created\n status=requires_payment_method\n client_secret returned) as s2
  }
  package "Database" as p5 <<DB_COLOR>> {
    (INSERT Payment\n status=REQUIRES_PAYMENT_METHOD) as d1
    (UPDATE Listing\n status=WAITING_FOR_PAYMENT\n currentPaymentIntentId) as d2
    (COMMIT) as d3
  }
}

rectangle "3. Buyer pays via PaymentSheet" as step3 {
  package "Frontend" as p6 <<FRONTEND_COLOR>> {
    (PaymentSheet present\n card or PromptPay) as f1
  }
  package "Stripe" as p7 <<STRIPE_COLOR>> {
    (3DS / SCA if card) as f2
    (PromptPay async) as f3
    (Card auth held\n PI=requires_capture) as f4
  }
}

rectangle "4. Webhook: payment authorized" as step4 {
  package "Webhook" as p8 <<BACKEND_COLOR>> {
    (verify sig\n INSERT StripeWebhookEvent\n dedupe) as w1
    (payment_intent.amount_capturable_updated) as w2
  }
  package "Database" as p9 <<DB_COLOR>> {
    (Payment.status=REQUIRES_CAPTURE) as d4
    (Listing.status=PAID\n no money has moved yet) as d5
  }
}

rectangle "5. Pickup in person" as step5 {
  package "Real world" as p10 {
    (Buyer & seller meet at\n PickupLocation building) as r1
    (Seller hands over item) as r2
  }
  package "Frontend" as p11 <<FRONTEND_COLOR>> {
    (Buyer taps Confirm Receipt) as r3
  }
}

rectangle "6. Capture funds" as step6 {
  package "Backend" as p12 <<BACKEND_COLOR>> {
    (paymentIntents.capture) as c1
  }
  package "Stripe" as p13 <<STRIPE_COLOR>> {
    (Capture splits funds atomically:\n  platformFee → platform balance\n  sellerNet   → connected-acct balance) as c2
  }
  package "Database" as p14 <<DB_COLOR>> {
    (Payment.status=SUCCEEDED\n capturedAt=now) as c3
    (Listing.status=RECEIVED) as c4
    (SellerProfile.totalEarnedSatang\n += sellerNet) as c5
  }
}

rectangle "7. Stripe auto-payout (T+7 TH, THB)" as step7 {
  package "Stripe" as p15 <<STRIPE_COLOR>> {
    (Stripe schedules payout from\n connected-acct balance) as o1
    (payout to seller's Thai bank) as o2
    (webhook: payout.paid) as o3
  }
  package "Bank" as p16 <<BANK_COLOR>> {
    (Funds settle in Thai bank acct) as o4
  }
  package "Database" as p17 <<DB_COLOR>> {
    (SellerProfile.totalPaidOutSatang\n += payout.amount) as o5
  }
  package "Frontend" as p18 <<FRONTEND_COLOR>> {
    (Seller wallet shows new\n live balance via\n stripe.balance.retrieve) as o6
  }
}

e1 --> e2
e2 --> v1
v1 --> v2
v2 --> v3
v3 --> s1
s1 --> s2
s2 --> d1
d1 --> d2
d2 --> d3
d3 --> f1
f1 --> f2
f1 --> f3
f2 --> f4
f3 --> f4
f4 --> w1
w1 --> w2
w2 --> d4
d4 --> d5
d5 --> r1
r1 --> r2
r2 --> r3
r3 --> c1
c1 --> c2
c2 --> c3
c3 --> c4
c4 --> c5
c5 --> o1
o1 --> o2
o2 --> o4
o2 --> o3
o3 --> o5
o5 --> o6

note right of step2
  Single PaymentIntent does it all:
   - charges buyer's card
   - routes seller's share to connected acct
   - retains platform fee
  No stripe.transfers.create or
  stripe.payouts.create needed.
end note

note right of step4
  Listing.status = PAID here means
  "authorized & locked", NOT "money in seller's hand".
  Money moves in step 6 (capture).
end note

note right of step6
  Failure paths NOT shown in main flow:
   - Buyer never confirms → expire-stale-auths job
     cancels PI after ~6 days → listing → AVAILABLE.
   - Dispute (charge.dispute.created) → admin review.
   - Refund (POST /payments/:id/refund) → reverse_transfer
     + refund_application_fee.
end note

note right of step7
  We never call stripe.payouts.create.
  Stripe runs payouts automatically on the
  connected account's schedule.
  Seller wallet UI reads LIVE state from Stripe.
end note

@enduml
