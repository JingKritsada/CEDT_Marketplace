@startuml seller-onboarding-flow
!define PROCESS_COLOR #B4D7FF
!define DECISION_COLOR #FFFFB4
!define ENDPOINT_COLOR #C8E6C9

' Stripe Connect Express onboarding for Thai sellers.
' Thailand: payouts in THB only, on a T+7 business-day rolling schedule.

start
:Seller registers (User row created);
:Seller taps "Become a Seller";
:POST /sellers/onboarding;

if (SellerProfile exists?) then (No)
  :Create SellerProfile row\nconnectStatus = NONE;
else (Yes)
endif

if (stripeConnectAccountId exists?) then (No)
  :stripe.accounts.create({\n  type: 'express',\n  country: 'TH',\n  capabilities: { card_payments, transfers },\n  business_type: 'individual'\n});
  :Persist stripeConnectAccountId\nconnectStatus = PENDING;
else (Yes)
endif

:stripe.accountLinks.create({\n  account, type: 'account_onboarding',\n  refresh_url, return_url\n});
:Return onboarding URL to frontend;
:Frontend opens Stripe-hosted onboarding\n(SFSafariViewController on iOS);

:Seller submits identity\n(name, DOB, Thai ID / passport);
:Seller submits Thai bank account\n(THB payout destination);
:Stripe runs verification\n(KYC + bank check);

:Stripe fires webhook: account.updated;
:Webhook handler refreshes SellerProfile:
  chargesEnabled
  payoutsEnabled
  detailsSubmitted
  requirementsDisabledReason
  requirementsCurrentlyDue[];

if (chargesEnabled && payoutsEnabled?) then (Yes)
  :connectStatus = ACTIVE;
  :Seller can now be a destination\nfor PaymentIntents;
  stop
else (No)
  if (requirementsDisabledReason set?) then (Yes)
    :connectStatus = RESTRICTED;
    :Surface requirementsCurrentlyDue\nin app ("upload your ID");
    :Seller re-enters onboarding\n→ loop back to AccountLink;
  else (No)
    :connectStatus = PENDING\n(Stripe still verifying);
    :Frontend polls GET /sellers/me\nor waits for next account.updated;
  endif
  stop
endif

note right
  We never call stripe.payouts.create.
  In destination-charge mode, Stripe
  auto-pays the connected account on
  its own T+7 (TH) schedule.
end note

@enduml
