{
	"compilerOptions": {
		"target": "ES2022",
		"module": "nodenext",
		"moduleDetection": "force",
		"moduleResolution": "nodenext",
		"lib": ["ES2022"],
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"noEmit": false,
		"outDir": "dist",
		"rootDir": ".",

		/* Path aliases */
		"paths": {
			"@/*": ["./src/*"]
		},
		"types": ["node"],

		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true
	},
	"include": ["src", "tests", "prisma", "server.ts"]
}
