generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum ListingStatus {
    AVAILABLE
    RESERVED
    SOLD
}

enum ListingCondition {
    NEW
    LIKE_NEW
    GOOD
    FAIR
    POOR
}

model User {
    id            String         @id @default(cuid())
    studentId     String?        @unique
    email         String         @unique
    displayName   String
    avatarUrl     String?
    passwordHash  String
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    listings      Listing[]
    buyerChatRoom ChatRoom[]     @relation("BuyerChatRooms")
    sellerChat    ChatRoom[]     @relation("SellerChatRooms")
    messages      Message[]
    refreshTokens RefreshToken[]
}

model Category {
    id        String    @id @default(cuid())
    name      String
    slug      String    @unique
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    listings  Listing[]
}

model PickupLocation {
    id          String    @id @default(cuid())
    name        String
    building    String
    description String?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    listings    Listing[]
}

model Listing {
    id               String           @id @default(cuid())
    sellerId         String
    title            String
    description      String
    price            Int
    isFree           Boolean          @default(false)
    status           ListingStatus    @default(AVAILABLE)
    condition        ListingCondition @default(GOOD)
    courseCode       String?
    categoryId       String?
    pickupLocationId String?
    images           String[]
    createdAt        DateTime         @default(now())
    updatedAt        DateTime         @updatedAt
    seller           User             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
    category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
    pickupLocation   PickupLocation?  @relation(fields: [pickupLocationId], references: [id], onDelete: SetNull)
    chatRooms        ChatRoom[]

    @@index([sellerId])
    @@index([status])
    @@index([courseCode])
}

model ChatRoom {
    id        String    @id @default(cuid())
    listingId String
    buyerId   String
    sellerId  String
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
    buyer     User      @relation("BuyerChatRooms", fields: [buyerId], references: [id], onDelete: Cascade)
    seller    User      @relation("SellerChatRooms", fields: [sellerId], references: [id], onDelete: Cascade)
    messages  Message[]

    @@unique([listingId, buyerId])
    @@index([sellerId])
}

model Message {
    id         String   @id @default(cuid())
    chatRoomId String
    senderId   String
    content    String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
    chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
    sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

    @@index([chatRoomId])
}

model RefreshToken {
    id        String   @id @default(cuid())
    token     String   @unique
    userId    String
    expiresAt DateTime
    createdAt DateTime @default(now())
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}
