{
	"name": "cedt-marketplace-backend",
	"version": "1.0.0",
	"description": "backend server for a mobile platform for buying/selling used electronics equipment among university students",
	"main": "dist/server.js",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"start": "node dist/server.js",
		"dev": "tsx watch --include \"src/**/*.ts\" src/server.ts",
		"format": "prettier --write \"{src,tests}/**/*.ts\" prisma.config.ts",
		"lint": "eslint \"{src,tests}/**/*.ts\" prisma.config.ts",
		"lint:fix": "eslint \"{src,tests}/**/*.ts\" prisma.config.ts --fix",
		"test": "tsx --test tests/**/*.test.ts",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:studio": "prisma studio"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "commonjs",
	"dependencies": {
		"@prisma/client": "^6.19.3",
		"bcryptjs": "^3.0.2",
		"cors": "^2.8.5",
		"dotenv": "^17.2.3",
		"express": "^5.1.0",
		"express-rate-limit": "^7.5.0",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.2",
		"morgan": "^1.10.1",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.1",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/node": "^25.7.0",
		"@types/supertest": "^6.0.3",
		"@types/swagger-jsdoc": "^6.0.4",
		"@types/swagger-ui-express": "^4.1.8",
		"@typescript-eslint/eslint-plugin": "^8.57.2",
		"@typescript-eslint/parser": "^8.57.2",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-no-relative-import-paths": "^1.6.1",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prisma": "^6.19.3",
		"supertest": "^7.1.4",
		"ts-node": "^10.9.2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}
